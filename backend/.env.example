# Social backend configuration. Copy to `.env` and adjust. Never commit real secrets.

# HTTP listen port.
PORT=4000

# Chain RPC endpoint (local Hardhat default).
RPC_URL=http://127.0.0.1:8545

# Deployed StakeBeast contract address (the expected emitter of CheckedIn events).
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Chain id (local Hardhat = 31337, Sepolia = 11155111).
CHAIN_ID=31337

# DEV-ONLY placeholder for local development. Replace with a strong random
# value anywhere else. The server refuses to boot when JWT_SECRET is unset.
JWT_SECRET=dev-only-insecure-secret-change-me

# Directory holding the SQLite database, media originals/thumbs, and avatars.
DATA_DIR=./data

# CORS allowlist (the frontend origin; comma-separated for several).
FRONTEND_ORIGIN=http://localhost:5173

# First block scanned for SessionCreated events by the review-list indexer.
INDEXER_START_BLOCK=0
