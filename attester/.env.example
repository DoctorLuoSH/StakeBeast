# Attestation service configuration. Copy to `.env` and fill in real values.
# NEVER commit a real private key. The key is loaded from the environment only.

# HTTP listen port.
PORT=8787

# Path of the JSON persistence file for session judgment state.
# The service recovers its state from this file after a restart.
ATTESTER_DB_PATH=./data/attester.json

# Private key used to sign EIP-712 completion proofs (0x-prefixed, 32 bytes).
# Required only for proof issuance; the service has NO transfer authority.
# TODO(DAPP-2): final key management / rotation policy.
ATTESTER_PRIVATE_KEY=0xREPLACE_WITH_ATTESTER_PRIVATE_KEY

# Chain the proofs are valid on (Sepolia = 11155111). Used for the EIP-712 domain.
# TODO(DAPP-2): freeze EIP-712 domain fields (name/version/chainId/verifyingContract).
CHAIN_ID=11155111
