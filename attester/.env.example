# Attestation service configuration. Copy to `.env` and fill in real values.
# NEVER commit a real private key — secrets come from the environment only.
# The key signs EIP-712 attestations; the service has NO transfer authority.

# JSON-RPC endpoint (local Hardhat by default; Sepolia RPC for testnet).
RPC_URL=http://127.0.0.1:8545

# Deployed StakeBeast contract address (0x-prefixed, 20 bytes).
CONTRACT_ADDRESS=0xREPLACE_WITH_DEPLOYED_CONTRACT_ADDRESS

# EIP-712 signing key (0x-prefixed, 32 bytes).
# Locally, a well-known Hardhat account key is fine; Sepolia uses a dedicated key.
ATTESTER_PRIVATE_KEY=0xREPLACE_WITH_ATTESTER_PRIVATE_KEY

# HTTP listen port.
PORT=3001

# Durable state directory (journal + snapshot; deleting it factory-resets the
# service — never do this with live sessions).
DATA_DIR=./data

# Optional safety check: expected chain id (0 / unset = auto-detect from RPC).
CHAIN_ID=0

# Browser origin allowlist for CORS (local dev default is permissive).
CORS_ORIGIN=*
