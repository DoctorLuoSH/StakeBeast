# Deployment wallet private key (never commit a real .env)
PRIVATE_KEY=
# Sepolia RPC endpoint (e.g. Alchemy / Infura URL)
RPC_URL=
# Attestation service signer address written into the contract at deploy time.
# (The matching signing key lives in attester/.env as ATTESTER_PRIVATE_KEY —
# different file, different purpose; the deployer only needs the address.)
ATTESTER_ADDRESS=
# Forfeited-stake charity recipient address written into the contract at deploy time
CHARITY_ADDRESS=
# Etherscan API key for `hardhat verify`
ETHERSCAN_API_KEY=
