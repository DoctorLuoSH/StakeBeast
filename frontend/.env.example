# StakeBeast frontend environment template.
# Copy to `.env` and fill in. Vite only exposes variables prefixed with VITE_.
# Zero-hardcode rule: real addresses/URLs live here, never in source.
#
# Required = the app boots without them, but the matching feature stays
# disabled (create/focus/settle need the contracts, machine-proof sessions
# need the proof service, social features need the backend).

# --- Contracts (required) ---
# StakeBeast session contract address. Sepolia: copy `stakeBeast` from
# deployments/sepolia.json after the WP7 deploy (see README "Deployment").
# Local Hardhat: copy `stakeBeast` from deployments/localhost.json.
VITE_CONTRACT_ADDRESS=
# BeastNFT contract address (same sources, key `beastNFT`).
VITE_NFT_CONTRACT_ADDRESS=

# --- Services (required for their features) ---
# Proof service base URL (machine attestation for focus sessions).
# Local: http://localhost:3001
VITE_PROOF_SERVICE_URL=
# Social backend REST API base URL, including the /api suffix.
# Local: http://localhost:4000/api
VITE_API_BASE_URL=

# --- Optional overrides ---
# Sepolia RPC endpoint used when adding Sepolia to the wallet
# (wallet_addEthereumChain). Empty = the public https://rpc.sepolia.org.
VITE_SEPOLIA_RPC_URL=

# Expected chain id override. Empty = Sepolia (11155111). Set 31337 together
# with the contract addresses from deployments/localhost.json when running
# against a local Hardhat node (see README "Local Hardhat walkthrough").
VITE_CHAIN_ID=

# Demo mode: "true" enables the zoo sample shelf in built (non-dev) bundles.
# Dev server always counts as demo mode. Leave empty/false for production.
VITE_DEMO_MODE=
