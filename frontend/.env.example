# StakeBeast frontend environment template.
# Copy to `.env` and fill in. Vite only exposes variables prefixed with VITE_.
# Zero-hardcode rule: real addresses/URLs live here, never in source.

# --- Contracts (Sepolia) — injected after deployment (WP1/WP2) ---
VITE_CONTRACT_ADDRESS=
VITE_NFT_CONTRACT_ADDRESS=

# --- Services ---
# Proof service (machine attestation for focus sessions)
VITE_PROOF_SERVICE_URL=
# Social backend REST API (P1)
VITE_API_BASE_URL=

# Optional Sepolia RPC override (used when adding Sepolia to the wallet)
VITE_SEPOLIA_RPC_URL=

# Demo mode: "true" enables the zoo sample shelf in built (non-dev) bundles.
# Dev server always counts as demo mode. Leave empty/false for production.
VITE_DEMO_MODE=
