# Root .env — Sepolia deployment only (never commit a real .env).
# Copy to .env and fill in every value, then:
#   npx hardhat run scripts/deploy.js --network sepolia
# Local runs (Hardhat node) need none of this; see README step 2-4.

# Private key of the deployment wallet (pays gas, becomes contract owner).
# 0x-prefixed 32-byte hex. Use a throwaway testnet key with Sepolia ETH only.
DEPLOYER_PRIVATE_KEY=

# Sepolia RPC endpoint (e.g. Alchemy / Infura HTTPS URL for chain 11155111).
SEPOLIA_RPC_URL=

# Etherscan API key for source verification (`hardhat verify`, free at
# etherscan.io/apis). When set, scripts/deploy.js verifies both contracts
# right after deployment; otherwise run scripts/verify.js later.
ETHERSCAN_API_KEY=

# Attester signing address — the address derived from the proof service's
# ATTESTER_PRIVATE_KEY (attester/.env, see attester runbook). Passed as the
# StakeBeast constructor's attester parameter; the contract accepts EIP-712
# CompletionAttestation signatures from this address only.
ATTESTER_ADDRESS=

# Forfeit sink: receives every forfeited / disputed stake (withdraw-only).
# Disclosure (contract-design v4.1 section 1): a team-controlled Sepolia
# testnet address standing in for a real charity. Must be non-zero.
CHARITY_ADDRESS=
